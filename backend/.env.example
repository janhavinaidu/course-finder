# =====================================================
# Backend Environment Variables
# =====================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to Git.

# --- LLM: Groq ---
# Get your key at: https://console.groq.com/
GROQ_API_KEY=

# --- Web Search: Google Custom Search Engine ---
# Get API key: https://console.cloud.google.com/
# Create CSE: https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- CORS: Allowed Frontend Origins ---
# Comma-separated list of allowed origins (no trailing slash)
# Example: https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=https://course-finder-six-indol.vercel.app,http://localhost:5173
